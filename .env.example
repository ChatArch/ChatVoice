# ChatVoice model-provider config belongs in ChatEnv typed profile:
#   ~/.chatarch/envs/ChatVoice/.env
#
# Use OPENAI-compatible fields under the ChatVoice namespace only. Production
# should use a Token Plan sk-sp... key here, not a usage-billed sk-... key.
CHATVOICE_OPENAI_API_BASE=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CHATVOICE_OPENAI_API_KEY=[REDACTED_TOKEN_PLAN_SK_SP]
CHATVOICE_OPENAI_API_MODEL=deepseek-v4-pro-0813

# ASR production should be persistent: either api-server or in-process FunASR.
# Do not enable the subprocess worker in production; it reloads the GPU model
# per request/chunk and causes repeated cold starts.
CHATVOICE_ASR_PREWARM=1
CHATVOICE_FUNASR_ALLOW_SUBPROCESS_WORKER=0
