# Canonical typed configuration: ~/.chatarch/envs/ChatVoice/.env
# Legacy TTS and realtime retain their Token Plan key requirement.
CHATVOICE_OPENAI_API_BASE=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CHATVOICE_OPENAI_API_KEY=
CHATVOICE_OPENAI_API_MODEL=deepseek-v4-pro-0813

# Independent TTS (local 0.1.15.post2 hotfix). Any nonempty field opts in.
# Type: volcengine or openai (root API base), or qwen (exact ws/wss URL).
# Explicit qwen still requires its own sk-sp Token Plan key.
# Set all fields except RESOURCE_ID (required only for volcengine).
# VOICES is a JSON list of {"id":"configured-voice","label":"Display name"}.
# First voice is default. No shared key or automatic fallback.
CHATVOICE_TTS_API_TYPE=
CHATVOICE_TTS_API_BASE=
CHATVOICE_TTS_API_KEY=
CHATVOICE_TTS_MODEL=
CHATVOICE_TTS_RESOURCE_ID=
CHATVOICE_TTS_VOICES=

# Independent text endpoints (0.1.15.post1 hotfix).
# If Base OR Key is set, Base + Key + Model are all required for that purpose.
# Supply real credentials through ChatEnv secure stdin, never commit them.
CHATVOICE_MEETING_NOTES_API_BASE=
CHATVOICE_MEETING_NOTES_API_KEY=
CHATVOICE_MEETING_NOTES_MODEL=
CHATVOICE_MEETING_TITLE_API_BASE=
CHATVOICE_MEETING_TITLE_API_KEY=
CHATVOICE_MEETING_TITLE_MODEL=

# Legacy notes selector applies only when independent Base AND Key are empty.
CHATVOICE_MEETING_NOTES_PROVIDER=token-plan-chat-completions
# Optional legacy CRS fields; configure only against an existing trusted CRS.
# CHATVOICE_MEETING_NOTES_CRS_PROFILE=<existing-profile>
# CHATVOICE_MEETING_NOTES_CRS_API_BASE=<trusted-crs-base>
# CHATVOICE_MEETING_NOTES_CRS_API_KEY=

# ASR must stay persistent: api-server or in-process FunASR.
CHATVOICE_ASR_PREWARM=1
CHATVOICE_FUNASR_ALLOW_SUBPROCESS_WORKER=0
